# Supabase (públicas: llegan al navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL base de la app, sin barra final (ej. https://app.ejemplo.pe). Se usa en los enlaces de los correos.
# Obligatoria en producción; en desarrollo, si falta, se usa el origen de la solicitud.
# Supabase > Authentication > URL Configuration: Site URL y Redirect URLs deben incluir <URL_APP>/auth/confirm
URL_APP=

# Conexión de la aplicación: pooler de transacciones de Supabase (puerto 6543)
DATABASE_URL=

# Solo para drizzle-kit (generar y aplicar migraciones): pooler de sesión (puerto 5432) o conexión directa
DATABASE_URL_MIGRACIONES=
